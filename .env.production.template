# Production Environment Configuration Template
# Copy this file to .env for production deployment
# IMPORTANT: Replace all placeholder values with actual production secrets
# Generate secure secrets: openssl rand -base64 32

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
POSTGRES_DB=ecom_db
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_MIN_16_CHARS
POSTGRES_PORT=5432

# Database connection string (auto-constructed in docker-compose)
# For external database, override DATABASE_URL directly
# DATABASE_URL=postgresql://user:password@host:5432/database?schema=public
# DIRECT_URL=postgresql://user:password@host:5432/database

# ============================================================================
# APPLICATION CONFIGURATION (REQUIRED)
# ============================================================================
APP_NAME=NestJS Ecommerce Platform
NODE_ENV=production
PORT=3000
API_URL=https://api.yourdomain.com

# ============================================================================
# JWT SECRETS (REQUIRED - GENERATE SECURE RANDOM STRINGS)
# ============================================================================
# Generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_STRING
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_THIS_TO_DIFFERENT_RANDOM_32_CHAR_STRING
REFRESH_TOKEN_EXPIRES_IN=7d
SECRET_API_KEY=CHANGE_THIS_TO_ANOTHER_RANDOM_32_CHAR_STRING

# ============================================================================
# ADMIN CREDENTIALS (REQUIRED)
# ============================================================================
ADMIN_NAME=Admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_ADMIN_PASSWORD
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PHONENUMBER=+1234567890

# ============================================================================
# REDIS CONFIGURATION (REQUIRED)
# ============================================================================
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_MIN_16_CHARS
# REDIS_URL is auto-constructed in docker-compose

# ============================================================================
# CORS CONFIGURATION (REQUIRED)
# ============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# EMAIL SERVICE (OPTIONAL - Required for email features)
# ============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
OTP_EXPIRES_IN=5m

# ============================================================================
# GOOGLE OAUTH (OPTIONAL - Required for Google login)
# ============================================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/auth/google/callback
GOOGLE_CLIENT_REDIRECT_URI=https://yourdomain.com/oauth-google-callback

# ============================================================================
# AWS S3 STORAGE (OPTIONAL - Required for file uploads)
# ============================================================================
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your_aws_access_key_id
S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your-production-bucket-name

# ============================================================================
# STATIC FILES CONFIGURATION
# ============================================================================
PREFIX_STATIC_ENDPOINT=https://api.yourdomain.com/media/static

# ============================================================================
# VNDATA CLOUD STORAGE (OPTIONAL - Alternative to AWS S3)
# ============================================================================
VNDATA_REGION=hcm
VNDATA_ACCESS_KEY_ID=your_vndata_access_key
VNDATA_SECRET_ACCESS_KEY=your_vndata_secret_key
VNDATA_CLOUD_STORAGE=
VNDATA_S3_ENDPOINT=https://s3-hcm-r2.s3cloud.vn

# ============================================================================
# AI SERVICE (OPTIONAL - Required for AI features)
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# ============================================================================
# PAYMENT API (OPTIONAL - Required for payment processing)
# ============================================================================
PAYMENT_API_KEY=your_payment_api_key_here

# ============================================================================
# MUX VIDEO SERVICE (OPTIONAL - Required for video features)
# ============================================================================
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_WEBHOOK_ENDPOINT=https://api.yourdomain.com/webhooks/mux
MUX_SIGNING_SECRET=your_mux_signing_secret

# ============================================================================
# DEPLOYMENT NOTES
# ============================================================================
# 1. Never commit this file with real values to version control
# 2. Use strong, randomly generated passwords (min 16 characters)
# 3. Rotate secrets regularly (every 90 days recommended)
# 4. Use different secrets for each environment (dev, staging, prod)
# 5. Store secrets securely (use secret management tools in production)
# 6. Validate all required variables before deployment
# 7. Test configuration in staging environment first
